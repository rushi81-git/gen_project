# GenAI Model Deployment & Monitoring Dashboard - Backend Configuration
# Environment: development | production | test
ENVIRONMENT=development
DEBUG=true

# API & Server Configuration
HOST=127.0.0.1
PORT=8000
API_PREFIX=/api

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Database Configuration
# Default: SQLite file inside backend directory
DATABASE_URL=sqlite:///./monitoring.db
# For PostgreSQL: postgresql+psycopg2://user:password@localhost:5432/monitoring

# Hugging Face Configuration
# Token for hosted inference provider API (never commit real tokens)
HF_API_TOKEN=hf_your_api_token_here
# Hosted API base URL (Default Hugging Face Router endpoint)
HF_API_BASE_URL=https://router.huggingface.co/hf-inference/models

# Local Model Defaults
DEFAULT_LOCAL_MODEL=distilbert/distilgpt2
MODEL_CACHE_DIR=./.cache/huggingface

# Operational Alert Thresholds
ALERT_ERROR_RATE_THRESHOLD=10.0
ALERT_P95_LATENCY_THRESHOLD_MS=2500.0
ALERT_CONSECUTIVE_FAILURES_THRESHOLD=3

# Privacy & Retention
LOG_PROMPT_BODY=true
MAX_PROMPT_PREVIEW_LENGTH=250
